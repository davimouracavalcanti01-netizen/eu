# =============================================================================
# Pedidinho — variáveis de ambiente
# Copie este arquivo para `.env.local` (desenvolvimento) e preencha.
# Na Vercel, cadastre as MESMAS variáveis em Settings → Environment Variables.
# NUNCA faça commit do .env.local (ele já está no .gitignore).
# =============================================================================

# --- Site -------------------------------------------------------------------
# Endereço público do site, sem barra no final.
# Desenvolvimento: http://localhost:3000 | Produção: https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail de suporte mostrado aos clientes (login, assinatura inativa, termos).
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@seudominio.com.br

# --- Supabase ---------------------------------------------------------------
# Supabase → Project Settings → API Keys
# URL do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Chave PÚBLICA ("Publishable key", começa com sb_publishable_). Pode ir para o navegador.
# (Projetos antigos: use a "anon key".)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA ("Secret key", começa com sb_secret_). ⚠️ NUNCA exponha.
# Ignora as regras de segurança (RLS); usada só no servidor (webhook).
# (Projetos antigos: use a "service_role key".)
SUPABASE_SECRET_KEY=

# --- Kiwify -----------------------------------------------------------------
# Link do checkout do seu produto de assinatura (Kiwify → Produtos → seu produto → Links).
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL=https://pay.kiwify.com.br/SEU_CODIGO
# Token do webhook (Kiwify → Apps → Webhooks → seu webhook → Token).
# ⚠️ Segredo: é ele que garante que o aviso de pagamento veio mesmo da Kiwify.
KIWIFY_WEBHOOK_TOKEN=

# --- E-mails (Resend) ---------------------------------------------------------
# Resend → API Keys → Create API Key (começa com re_). ⚠️ Segredo.
RESEND_API_KEY=
# Remetente dos e-mails. O domínio precisa estar verificado no Resend.
EMAIL_FROM="Pedidinho <ola@seudominio.com.br>"
